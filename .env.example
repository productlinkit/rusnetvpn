# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables,
# and inlines them at build time — changing one needs a restart / rebuild.

# Backend base URL, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8090/api/v1

# How long a request may take before it is aborted, in milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000

# Google Sign-In web client id. Leave empty to hide the Google button —
# the backend does not mount POST /auth/google when it is unconfigured either,
# so an empty value here keeps the two ends in agreement.
VITE_GOOGLE_CLIENT_ID=
